# Handle line endings automatically for files detected as text
# and leave all other files alone.
* text=auto

# Force LF line endings on checkouts for source, project, and scripting files.
# This ensures cross-platform build compatibility (especially Xcode on iOS/macOS).
*.pbxproj text eol=lf merge=union
*.plist text eol=lf
*.xcworkspacedata text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf

# Windows-specific files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Ignore binary files from line ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.db binary
*.exe binary
pocketbase_linux binary
